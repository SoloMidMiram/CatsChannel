# Copy to .env locally. Never put real secrets in this example.
BOT_TOKEN=
# Your numeric Telegram user ID, not your username. Only this user can use the demo.
ADMIN_USER_ID=
# Optional: channel numeric ID (usually -100...) or @channelusername.
CHANNEL_ID=
# Optional absolute path to a Netscape-format cookie file outside Git.
YOUTUBE_COOKIE_FILE=
# baseline, or pot_bgutil after installing the optional profile and provider server.
YOUTUBE_PROFILE=baseline
# Required only for pot_bgutil; use http://127.0.0.1:4416 for a host-published server.
YOUTUBE_POT_PROVIDER_URL=
# Optional explicit route used by yt-dlp without mutating global proxy variables.
# Example for Xray on Windows/WSL mirrored networking: socks5h://127.0.0.1:10808
YOUTUBE_PROXY=
DOWNLOAD_DIR=downloads
MAX_DOWNLOAD_MB=45
MAX_DURATION_SECONDS=300
# Reserved for a separate future Telethon worker; unused by this demo.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION=.secrets/user
