# Copy to .env locally. Never put real secrets in this example.
BOT_TOKEN=
# Your numeric Telegram user ID, not your username. Only this user can use the demo.
ADMIN_USER_ID=
# Optional: channel numeric ID (usually -100...) or @channelusername.
CHANNEL_ID=
# Explicit aiogram Bot API route for polling, files, sends, diagnostics and recovery.
# Independent of TELEGRAM_PROXY (Telethon) and YOUTUBE_PROXY (yt-dlp).
# Supports http, socks4/socks4a, socks5/socks5h; SOCKS uses remote DNS. No direct fallback.
BOT_API_PROXY=
BOT_API_TIMEOUT_SECONDS=60
# Optional absolute path to a Netscape-format cookie file outside Git.
YOUTUBE_COOKIE_FILE=
# baseline, or pot_bgutil after installing the optional profile and provider server.
YOUTUBE_PROFILE=baseline
# Required only for pot_bgutil; use http://127.0.0.1:4416 for a host-published server.
YOUTUBE_POT_PROVIDER_URL=
# Optional explicit route used by yt-dlp without mutating global proxy variables.
# Example for Xray on Windows/WSL mirrored networking: socks5h://127.0.0.1:10808
YOUTUBE_PROXY=
DOWNLOAD_DIR=downloads
MAX_DOWNLOAD_MB=45
MAX_DURATION_SECONDS=300
# Set telegram_bot to receive videos from the third-party bot instead of yt-dlp.
MEDIA_BACKEND=yt_dlp
# Optional userbot extra: obtain these from your Telegram developer application.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# WSL: prefer a Linux path, e.g. /home/YOUR_WSL_USER/.local/share/cats-channel/user
# The relative default below is useful for Windows; keep session files private.
TELETHON_SESSION=.secrets/user
# Explicit Telethon/MTProto route. This is independent from YOUTUBE_PROXY.
# Example for a local Xray SOCKS inbound: socks5h://127.0.0.1:10808
TELEGRAM_PROXY=
TELEGRAM_DOWNLOADER_BOT=whatsmusicbot
TELEGRAM_RESPONSE_TIMEOUT=180
# Async persistence URL. SQLite is for local development/tests; production uses
# postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE from a secret manager.
DATABASE_URL=sqlite+aiosqlite:///cats_channel.sqlite3
# Requires the persistence extra, migrations at head and a numeric CHANNEL_ID.
# Enables durable /post intake, reply links and explicit /pilot_publish approval.
# Set true in the private pilot profile after migration 0005. No automatic publishing.
REPLY_ENTRIES_ENABLED=false
# Structured application diagnostics are written to stderr; CLI results stay on stdout.
LOG_LEVEL=WARNING
