{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SoloMidMiram/CatsChannel/project-context/source.schema.json",
  "title": "CatsChannel project context source",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "locator",
    "captured_at",
    "freshness",
    "last_verified_at"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^source-[0-9]{3}$"},
    "kind": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date"},
    "freshness": {"enum": ["current", "stable", "historical", "stale", "unknown"]},
    "last_verified_at": {"type": "string", "format": "date"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
